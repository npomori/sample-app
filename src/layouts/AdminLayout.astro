---
interface Props {
  title: string
}

const { title } = Astro.props
import 'virtual:participant-app-base/global.css'
import { displayName } from 'virtual:participant-app-base/config'

const access = Astro.locals.access
const hasSession = access.kind === 'ok' || access.kind === 'no-grant'
const showGrants = access.kind === 'ok' && access.user.role === 'admin'
const showRoles =
  access.kind === 'ok' && (access.user.role === 'admin' || access.user.role === 'manager')
const onAdmin = Astro.url.pathname === '/admin'
Astro.response.headers.set('Cache-Control', 'no-store')
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-gray-50 text-gray-900">
    <header class="fixed z-30 w-full border-b border-white/10 bg-black text-white">
      <div class="px-3 py-3 lg:px-5">
        <div class="flex items-center justify-between gap-4">
          <div class="flex items-center">
            <label
              for="admin-sidebar"
              class="mr-2 cursor-pointer rounded p-2 text-white hover:bg-white/10 lg:hidden"
            >
              <span class="sr-only">サイドバー</span>
              <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path
                  fill-rule="evenodd"
                  d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h6a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z"
                  clip-rule="evenodd"
                ></path>
              </svg>
            </label>
            <a class="text-lg font-semibold whitespace-nowrap text-white lg:ml-64" href="/admin">
              {displayName}
            </a>
          </div>
          <div class="flex items-center gap-4 text-sm">
            {showGrants && (
              <a class="text-white underline" href="/grants">
                利用許可の例外
              </a>
            )}
            {showRoles && (
              <a class="text-white underline" href="/roles">
                アプリ内ロール
              </a>
            )}
            {hasSession ? (
              <form method="post" action="/logout">
                <button
                  type="submit"
                  class="rounded-md bg-white px-4 py-2 text-sm font-medium text-gray-900 hover:bg-gray-200"
                >
                  ログアウト
                </button>
              </form>
            ) : (
              <a
                class="rounded-md bg-white px-4 py-2 font-medium text-gray-900 hover:bg-gray-200"
                href="/admin"
              >
                ログイン
              </a>
            )}
          </div>
        </div>
      </div>
    </header>
    <div class="flex overflow-hidden bg-gray-50 pt-16">
      <input id="admin-sidebar" type="checkbox" class="peer hidden" />
      <aside
        class="peer-checked:max-lg:flex fixed top-0 left-0 z-20 h-full w-64 max-lg:hidden flex-col pt-16 lg:flex"
        aria-label="サイドバー"
      >
        <div class="relative flex min-h-0 flex-1 flex-col border-r border-gray-200 bg-white pt-0">
          <div class="flex flex-1 flex-col overflow-y-auto pt-5 pb-4">
            <div class="flex-1 bg-white px-3">
              <ul class="space-y-2 pb-2">
                <li>
                  <a
                    href="/admin"
                    aria-current={onAdmin ? 'page' : undefined}
                    class:list={[
                      'flex items-center rounded-lg p-2 text-base text-gray-900 hover:bg-gray-100',
                      onAdmin && 'bg-gray-100'
                    ]}
                  >
                    管理
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </aside>
      <main class="relative min-h-[calc(100vh-4rem)] w-full overflow-y-auto bg-gray-50 lg:ml-64">
        <div class="px-4 py-8 lg:px-8">
          <slot />
        </div>
      </main>
    </div>
  </body>
</html>
