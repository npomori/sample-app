---
interface Props {
  title: string
}

const { title } = Astro.props
import 'virtual:astro-participant-auth/global.css'
import { displayName } from 'virtual:astro-participant-auth/config'

Astro.response.headers.set('Cache-Control', 'no-store')
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-gray-50 text-gray-900">
    <header class="border-b border-black/10 bg-brand text-white">
      <nav class="mx-auto flex max-w-3xl items-center justify-between px-4 py-4">
        <a class="text-lg font-semibold text-white" href="/">
          {displayName}
        </a>
        <a
          class="rounded-md bg-white px-4 py-2 text-sm font-medium text-gray-900 hover:bg-gray-200"
          href="/admin"
        >
          ログイン
        </a>
      </nav>
    </header>
    <main class="mx-auto max-w-3xl px-4 py-10">
      <slot />
    </main>
  </body>
</html>
